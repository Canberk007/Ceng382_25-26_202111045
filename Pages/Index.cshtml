@page
@model IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h4 class="mb-3 text-center">@(Model.IsEditMode ? "Edit Class" : "Add Class")</h4>
                <form method="post">
                    <input type="hidden" asp-for="NewClass.Id" />
                    <div class="mb-3">
                        <label class="form-label">Class Name</label>
                        <input type="text" asp-for="NewClass.ClassName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Student Count</label>
                        <input type="number" asp-for="NewClass.StudentCount" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="NewClass.Description" class="form-control" required></textarea>
                    </div>
                    <button type="submit" asp-page-handler="@(Model.IsEditMode ? "Edit" : "Add")"
                        class="btn @(Model.IsEditMode ? "btn-warning" : "btn-primary") w-100">
                        <i class="bi @(Model.IsEditMode ? "bi-pencil-square" : "bi-plus-circle")"></i>
                        @(Model.IsEditMode ? "Update Class" : "Add Class")
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm p-4">
                <h4 class="mb-3">Class List</h4>

                <!-- 🔍 FILTER FORM -->
                <form method="get" class="row g-2 mb-3">
                    <div class="col-md-8">
                        <input type="text" name="ClassNameFilter" class="form-control" placeholder="Filter by Class Name" value="@Model.ClassNameFilter" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-outline-primary w-100">
                            <i class="bi bi-search"></i> Filter
                        </button>
                    </div>
                </form>

                <!-- 📄 TABLE -->
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FilteredData)
                        {
                            <tr>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" asp-page-handler="EditSelect" class="btn btn-info btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </form>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- 🔢 PAGINATION -->
                <nav aria-label="Page navigation" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="?ClassNameFilter=@Model.ClassNameFilter&CurrentPage=@(Model.CurrentPage - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?ClassNameFilter=@Model.ClassNameFilter&CurrentPage=@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?ClassNameFilter=@Model.ClassNameFilter&CurrentPage=@(Model.CurrentPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>

            </div>
        </div>
    </div>
</div>
