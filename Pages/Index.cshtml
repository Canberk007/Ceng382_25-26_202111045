@page
@model MyApp.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<link rel="stylesheet" href="~/css/site.css" />

<div class="container mt-4">
  <h2 class="mb-3">Class Table</h2>

  <form method="get" class="mb-3">
    <div class="input-group">
      <input type="text"
             name="SearchTerm"
             value="@Model.SearchTerm"
             class="form-control"
             placeholder="Search name or department..." />
      <button type="submit" class="btn btn-primary">Filter</button>
    </div>
  </form>

  <form method="post" asp-page-handler="ExportJson" id="exportForm">
    <input type="hidden" name="SearchTerm"    value="@Model.SearchTerm" />
    <input type="hidden" name="CurrentPage"    value="@Model.CurrentPage" />
    <input type="hidden" name="SelectedColumns" id="selectedColumns" />
    <input type="hidden" name="SelectedRows"    id="selectedRows" />

    <table class="table table-striped table-hover table-exportable">
      <thead>
        <tr>
          <th class="col-Name"        onclick="toggleColumn('Name', this)">Name</th>
          <th class="col-Description" onclick="toggleColumn('Description', this)">Description</th>
          <th class="col-CreatedDate" onclick="toggleColumn('CreatedDate', this)">Created Date</th>
          <th class="col-Grade"       onclick="toggleColumn('Grade', this)">Grade</th>
          <th class="col-Department"  onclick="toggleColumn('Department', this)">Department</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var c in Model.FilteredData)
        {
          <tr data-id="@c.ID" onclick="toggleRow(@c.ID, this)">
            <td class="col-Name">@c.Name</td>
            <td class="col-Description">@c.Description</td>
            <td class="col-CreatedDate">@c.CreatedDate.ToShortDateString()</td>
            <td class="col-Grade">@c.Grade</td>
            <td class="col-Department">@c.Department</td>
          </tr>
        }
      </tbody>
    </table>

    <button type="submit" class="btn btn-success">Export JSON</button>
  </form>

  <nav class="mt-3">
    <ul class="pagination">
      @if (Model.CurrentPage > 1)
      {
        <li class="page-item">
          <a class="page-link"
             href="?SearchTerm=@Model.SearchTerm&CurrentPage=@(Model.CurrentPage-1)">« Prev</a>
        </li>
      }
      @for (int i = 1; i <= Model.TotalPages; i++)
      {
        <li class="page-item @(i==Model.CurrentPage?"active":"")">
          <a class="page-link" href="?SearchTerm=@Model.SearchTerm&CurrentPage=@i">@i</a>
        </li>
      }
      @if (Model.CurrentPage < Model.TotalPages)
      {
        <li class="page-item">
          <a class="page-link"
             href="?SearchTerm=@Model.SearchTerm&CurrentPage=@(Model.CurrentPage+1)">Next »</a>
        </li>
      }
    </ul>
  </nav>
</div>

@section Scripts {
<script>
  const selectedCols = new Set();
  const selectedRows = new Set();

  function toggleColumn(col, th) {
    const cells = document.querySelectorAll(".col-" + col);
    if (selectedCols.has(col)) {
      selectedCols.delete(col);
      th.classList.remove("selected-column");
      cells.forEach(c => c.classList.remove("selected-column"));
    } else {
      selectedCols.add(col);
      th.classList.add("selected-column");
      cells.forEach(c => c.classList.add("selected-column"));
    }
    document.getElementById("selectedColumns").value = JSON.stringify([...selectedCols]);
  }

  function toggleRow(id, tr) {
    const cells = tr.querySelectorAll("td");
    if (selectedRows.has(id)) {
      selectedRows.delete(id);
      tr.classList.remove("selected-row");
    } else {
      selectedRows.add(id);
      tr.classList.add("selected-row");
    }
    document.getElementById("selectedRows").value = JSON.stringify([...selectedRows]);
  }
</script>
}

<style>
  th { cursor: pointer; }
  tr { cursor: pointer; }
  .selected-column { background-color: #ffc107 !important; }
  .selected-row    { background-color: #d0e7ff !important; }
</style>
