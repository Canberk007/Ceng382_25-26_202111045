@page
@model IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container">
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />
                <div class="form-group">
                    <label>Class Name</label>
                    <input type="text" asp-for="NewClass.ClassName" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Student Count</label>
                    <input type="number" asp-for="NewClass.StudentCount" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea asp-for="NewClass.Description" class="form-control" required></textarea>
                </div>
                <button type="submit" asp-page-handler="@(Model.IsEditMode ? "Edit" : "Add")" class="btn @(Model.IsEditMode ? "btn-warning" : "btn-primary")">
                    @(Model.IsEditMode ? "Edit Class" : "Add Class")
                </button>
            </form>
        </div>
        <div class="col-md-8">
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in IndexModel.Classes)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger">
                            <i class="bi bi-trash"></i>
                            </button>
                                
                            <button type="submit" asp-page-handler="EditSelect" class="btn btn-info">
                             <i class="bi bi-pencil"></i>
                            </button>
                  </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
